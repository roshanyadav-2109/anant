# Copy to .env and fill in.

# The Anant Engine (FastAPI). Required in production — also set it in
# Vercel → Project → Environment Variables. Dev falls back to the bundled
# ngrok URL if unset; anant.ts also sends the ngrok-skip-browser-warning header.
VITE_ANANT_API_URL=https://scoldedly-unfinical-julius.ngrok-free.dev

# Optional: Supabase — only used by the "Sign in with Google" app-login button
# (separate from the Google *connector*). The anon key is browser-safe.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
